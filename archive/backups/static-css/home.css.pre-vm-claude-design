/* ============================================================
   Homepage-only styles. Scoped with .home- prefixes so these do
   NOT affect other pages that import style.css.
   Palette: deep navy #0f2f44 / steel #45667c / warm orange #f5a650.
   ============================================================ */

:root{
    --h-navy: #0b2a3d;
    --h-navy-2: #122f45;
    --h-steel: #45667c;
    --h-orange: #f5a650;
    --h-text: #e8eff5;
    --h-muted: #9fb3c4;
}

/* ------- HERO -------
   Stacking strategy (per the spec):
   - .home-hero paints the image via explicit background-* properties,
     with a solid navy fallback color so there is NEVER a white pixel if
     the image fails to cover for any reason.
   - .home-hero::before is the dedicated semi-transparent black overlay.
     Using `isolation: isolate` on the hero means z-index:-1 on ::before
     stays INSIDE the hero's stacking context — above the image, below content.
   - .home-hero-wrap holds the content and naturally paints on top. */
.home-hero{
    position: relative;
    isolation: isolate;              /* new stacking context: z-index:-1 stays scoped */
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 100vh;               /* fill viewport, no white strip under hero */
    overflow: hidden;

    background-color: #0b2a3d;       /* navy fallback — kills any white gap */
    background-image: var(--h-hero-img);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
}
/* Semi-transparent black overlay — real layer, edge-to-edge */
.home-hero::before{
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.50);
    z-index: -1;                     /* above image (background), below content */
    pointer-events: none;
}

.home-hero-wrap{
    position: relative;
    z-index: 1;                      /* above the ::before overlay */
    max-width: 820px;
    margin: 0 auto;
    padding: 120px 24px 100px;
    width: 100%;
    direction: rtl;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}
.home-hero h1{
    color: #fff;
    font-family: 'IBM Plex Sans Arabic', 'Tajawal', system-ui, sans-serif;
    font-size: clamp(26px, 3.6vw, 44px);
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 18px;
    letter-spacing: -0.3px;
    max-width: 760px;
    text-shadow: 0 2px 12px rgba(0,0,0,.35);
}
.home-hero h1 span{ display: block; }
.home-hero h1 .h-accent{
    color: var(--h-orange);
    margin-top: 4px;
}
.home-hero p{
    color: #e8eef5;
    font-family: 'IBM Plex Sans Arabic', 'Tajawal', system-ui, sans-serif;
    font-size: clamp(14px, 1.3vw, 16px);
    font-weight: 400;
    max-width: 560px;
    line-height: 1.85;
    margin: 0 0 28px;
    text-shadow: 0 1px 8px rgba(0,0,0,.35);
}
.home-hero-cta{
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
}
.home-hero-cta a{
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    border-radius: 999px;
    font-family: 'IBM Plex Sans Arabic', 'Tajawal', system-ui, sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    transition: transform .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
}
.home-hero-cta a:hover{
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0,0,0,.25);
}
.home-hero-cta .h-btn-primary{
    background: var(--h-orange);
    color: #1a1a1a;
    border: 1px solid var(--h-orange);
}
.home-hero-cta .h-btn-ghost{
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,.75);
}
.home-hero-cta .h-btn-ghost:hover{
    background: #fff;
    color: var(--h-navy);
}

/* ------- Section skeleton ------- */
.home-sec{ padding: 90px 24px; }
.home-sec-wrap{ max-width: 1240px; margin: 0 auto; direction:rtl; }
.home-sec-title{
    text-align:center;
    color:#0b2a3d;
    font-size: clamp(26px, 3vw, 36px);
    font-weight:800;
    margin: 0 0 16px;
    position:relative;
    padding-bottom:16px;
}
.home-sec-title::after{
    content:"";
    position:absolute;
    left:50%; bottom:0;
    transform:translateX(-50%);
    width:72px; height:3px;
    background:var(--h-orange);
    border-radius:2px;
}
.home-sec-lead{
    text-align:center;
    color:#4a6174;
    max-width:720px;
    margin: 0 auto 32px;
    line-height:1.95;
    font-size:16px;
}

/* ================================================================
   VISION / MISSION — exact match to the attached reference
   Reference analysis:
   - Both panels are rounded rectangles (~14px) with ONE chamfered
     corner each: vision has top-LEFT bevel, mission has top-RIGHT
     bevel. The chamfers face each other.
   - A short orange diagonal bar sits in the V-opening between them.
   - Vision = navy, white text, headings vertically centered, with a
     layered orange+gold slanted-blade decoration bottom-right.
   - Mission = white, navy text, 1px orange hairline border, soft
     peach triangular wash in the bottom-left corner.
   - Numeral + hairline marker sits at the top-outer corner of each.
   ================================================================ */

/* Short orange accent LINE ABOVE the section heading. */
.home-sec-title--accent-top{
    padding-top: 22px;
    padding-bottom: 0;
}
.home-sec-title--accent-top::after{ display: none; }
.home-sec-title--accent-top::before{
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 3px;
    background: var(--h-orange);
    border-radius: 2px;
}

/* ---- Layout ---- */
.home-vm{
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    direction: rtl;
    isolation: isolate;
    min-height: 420px;
}

/* ---- Central short diagonal orange divider ----
   Lives in the gap between the two bevels, tilted slightly. */
.home-vm::before{
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 5px;
    height: 100px;
    background: var(--h-orange);
    transform: translate(-50%, -50%) rotate(14deg);
    border-radius: 3px;
    z-index: 4;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(245, 166, 80, .45);
}

/* ---- Shared panel surface ---- */
.home-vm-panel{
    position: relative;
    padding: 72px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;      /* vertical centering of heading+body */
    gap: 18px;
    border-radius: 14px;
    overflow: hidden;
    font-family: 'IBM Plex Sans Arabic', 'Tajawal', system-ui, sans-serif;
    text-align: right;
}

/* ---- VISION PANEL (right in RTL) ---- */
.home-vm-vision{
    background: var(--h-navy);
    color: #fff;
    box-shadow: 0 24px 50px -24px rgba(10, 25, 38, .3);
    z-index: 2;
}
/* Top-LEFT corner chamfer — a 90x90 triangle painted in the section
   background color, overlaying the corner to simulate a 45° bevel.
   Looks like the panel's corner is cut. */
.home-vm-vision > .home-vm-chamfer{
    position: absolute;
    top: -1px;
    left: -1px;
    width: 110px;
    height: 110px;
    background: #f6f9fc;              /* matches section background */
    clip-path: polygon(0 0, 100% 0, 0 100%);
    z-index: 3;
    pointer-events: none;
}

/* ---- MISSION PANEL (left in RTL) ---- */
.home-vm-mission{
    background: #fff;
    color: var(--h-navy);
    box-shadow: 0 20px 40px -28px rgba(10, 25, 38, .18);
    z-index: 1;
    /* 1px orange hairline border — painted via inset shadow so it
       hugs the rounded corners cleanly. */
    box-shadow:
        inset 0 0 0 1px rgba(245, 166, 80, .35),
        0 20px 40px -28px rgba(10, 25, 38, .18);
}
/* Top-RIGHT corner chamfer — mirror of vision's. */
.home-vm-mission > .home-vm-chamfer{
    position: absolute;
    top: -1px;
    right: -1px;
    width: 110px;
    height: 110px;
    background: #f6f9fc;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
    z-index: 3;
    pointer-events: none;
}
/* The hairline border should ALSO trace along the chamfer edge.
   An extra orange 1px line is drawn on the chamfer hypotenuse. */
.home-vm-mission > .home-vm-chamfer::after{
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 156px;    /* diagonal length of a 110x110 right triangle */
    height: 1px;
    background: rgba(245, 166, 80, .35);
    transform-origin: top right;
    transform: rotate(135deg);
}

/* ---- Top-outer-corner marker: hairline + numeral ---- */
.home-vm-marker{
    position: absolute;
    top: 44px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'IBM Plex Sans Arabic', 'Tajawal', system-ui, sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--h-orange);
    z-index: 5;
}
.home-vm-marker::before{
    content: "";
    display: block;
    width: 70px;
    height: 1px;
    background: var(--h-orange);
    opacity: .95;
}
/* Vision marker: top-RIGHT, hairline extends to its LEFT (inward) */
.home-vm-vision .home-vm-marker{
    right: 56px;
    flex-direction: row-reverse;    /* numeral on right, hairline left */
}
/* Mission marker: top-LEFT, hairline extends to its RIGHT (inward) */
.home-vm-mission .home-vm-marker{
    left: 56px;
    flex-direction: row;
}

/* ---- Headings ---- */
.home-vm-head{
    font-weight: 700;
    font-size: 34px;
    line-height: 1.3;
    margin: 0;
    position: relative;
    padding-bottom: 14px;
    letter-spacing: -0.3px;
    text-align: right;
    z-index: 2;
}
.home-vm-vision .home-vm-head{ color: #fff; }
.home-vm-mission .home-vm-head{ color: var(--h-navy); }
.home-vm-head::after{
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    width: 56px;
    height: 2px;
    background: var(--h-orange);
    border-radius: 2px;
}

/* ---- Body text ---- */
.home-vm-body{
    font-weight: 400;
    font-size: 15.5px;
    line-height: 2;
    margin: 10px 0 0;
    max-width: 44ch;
    text-align: right;
    position: relative;
    z-index: 2;
}
.home-vm-vision .home-vm-body{ color: rgba(255, 255, 255, .85); }
.home-vm-mission .home-vm-body{ color: #4a6174; }

/* ---- Vision bottom-right decoration ----
   Two overlapping SLANTED PARALLELOGRAM blades extending from the
   right edge: orange on top, gold/brown underneath. */
.home-vm-deco{
    position: absolute;
    right: 0;
    bottom: 0;
    width: 260px;
    height: 130px;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
}
.home-vm-deco::before,
.home-vm-deco::after{
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
}
/* Underlayer: muted gold slanted blade */
.home-vm-deco::before{
    width: 260px;
    height: 95px;
    background: linear-gradient(100deg, #6a4a26 0%, #9c7239 55%, #b8864a 100%);
    clip-path: polygon(28% 100%, 100% 100%, 100% 10%, 72% 10%);
    opacity: .95;
}
/* Top layer: orange slanted blade, slightly offset upward */
.home-vm-deco::after{
    width: 220px;
    height: 115px;
    background: linear-gradient(100deg, #d8832c 0%, var(--h-orange) 55%, #f7b56a 100%);
    clip-path: polygon(26% 100%, 100% 100%, 100% 8%, 70% 8%);
}

/* ---- Mission bottom-left soft peach triangular wash ---- */
.home-vm-mission::after{
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 55%;
    height: 55%;
    background: linear-gradient(
        135deg,
        rgba(245, 166, 80, .18) 0%,
        rgba(245, 166, 80, .06) 55%,
        transparent 100%
    );
    clip-path: polygon(0 0, 0 100%, 100% 100%);
    pointer-events: none;
    z-index: 1;
}

/* ------- EVENTS GRID ------- */
.home-events-grid{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}
.home-event-card{
    background:#fff;
    border-radius: 14px;
    overflow:hidden;
    box-shadow: 0 8px 24px rgba(10,25,38,.08);
    transition: transform .3s ease, box-shadow .3s ease;
    display:flex;
    flex-direction:column;
}
.home-event-card:hover{
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(10,25,38,.14);
}
.home-event-img{
    position:relative;
    aspect-ratio: 16/10;
    overflow:hidden;
    background:#e9eef3;
}
.home-event-img img{
    width:100%; height:100%;
    object-fit:cover;
    transition: transform .5s ease;
}
.home-event-card:hover .home-event-img img{ transform: scale(1.05); }
.home-event-date{
    position:absolute;
    top:14px;
    inset-inline-start:14px;
    background:#fff;
    color:var(--h-navy);
    padding: 8px 12px;
    border-radius:8px;
    font-weight:800;
    text-align:center;
    line-height:1.1;
    box-shadow: 0 4px 12px rgba(0,0,0,.15);
}
.home-event-date .d{ font-size:18px; display:block }
.home-event-date .m{ font-size:11px; color:var(--h-orange); text-transform:uppercase; letter-spacing:1px }
.home-event-body{
    padding: 20px 22px 22px;
    display:flex;
    flex-direction:column;
    flex:1;
}
.home-event-body h3{
    color:var(--h-navy);
    font-size:18px;
    font-weight:800;
    margin: 0 0 10px;
    line-height:1.5;
}
.home-event-meta{
    color:#6a7f91;
    font-size:14px;
    margin:0 0 16px;
    display:flex; align-items:center; gap:8px;
}
.home-event-meta b{color:var(--h-navy); font-weight:700}
.home-event-link{
    margin-top:auto;
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid #e6ebf0;
    color: var(--h-orange);
    text-decoration:none;
    font-weight:700;
    font-size:13px;
    width: fit-content;
    transition: all .25s;
}
.home-event-link:hover{
    background: var(--h-orange);
    color:#fff;
    border-color: var(--h-orange);
}
.home-events-more{
    text-align:center;
    margin-top: 40px;
}
.home-events-more a{
    color: var(--h-orange);
    font-weight:700;
    text-decoration:none;
    display:inline-flex;
    gap:8px;
    align-items:center;
}

/* ------- ARTICLES — editorial: 1 featured + 2 small, balanced ------- */
.home-articles{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start; /* don't stretch — each card uses its intrinsic height */
}

/* Top bar above the grid: "عرض جميع المقالات" link */
.home-articles-top{
    display:flex;
    justify-content: flex-start; /* flex-start in RTL = right */
    margin: 0 0 20px;
}
.home-articles-top a{
    color: var(--h-orange);
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    display:inline-flex;
    gap:6px;
    align-items:center;
}
.home-articles-top a:hover{ color: var(--h-navy); }

/* ---- Featured (RTL: first grid child = right column) ---- */
.home-article-featured{
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16/10;             /* balanced landscape, no runaway height */
    display: flex;
    text-decoration: none;
    color: #fff;
    box-shadow: 0 6px 20px rgba(10,25,38,.08);
    transition: transform .25s ease, box-shadow .25s ease;
}
.home-article-featured:hover{
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(10,25,38,.14);
}
.home-article-featured img{
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: transform .6s ease;
}
.home-article-featured:hover img{ transform: scale(1.04); }
.home-article-featured::after{
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg,
        rgba(10,25,38,0) 0%,
        rgba(10,25,38,.30) 50%,
        rgba(10,25,38,.82) 100%);
}
.home-article-featured-body{
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding: 20px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    direction: rtl;
    width: 100%;
}
.home-article-featured .home-article-tag{
    position: static;
    align-self: flex-start;
    background: var(--h-orange);
    color: #1a1a1a;
    padding: 5px 12px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11.5px;
    width: fit-content;
}
.home-article-featured h3{
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 800;
    color: #fff;
    margin: 0;
    line-height: 1.4;
    /* keep to 2 lines so proportions stay stable */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.home-article-featured-meta{
    color: #d8e0e8;
    font-size: 12.5px;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}
.home-article-featured-meta b{ color: #fff; font-weight: 700; }
.home-article-featured-link{
    margin-top: 2px;
    color: var(--h-orange);
    font-weight: 700;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
}

/* ---- Small cards column (RTL: second grid child = left column) ---- */
.home-article-small-col{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
}
.home-article-small{
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(10,25,38,.08);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform .25s ease, box-shadow .25s ease;
}
.home-article-small:hover{
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(10,25,38,.14);
}
.home-article-small-img{
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: #e9eef3;
}
.home-article-small-img img{
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
}
.home-article-small:hover .home-article-small-img img{ transform: scale(1.05); }
.home-article-small-body{
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    direction: rtl;
}
.home-article-small-body h3{
    color: var(--h-navy);
    font-size: 15px;
    font-weight: 800;
    margin: 0;
    line-height: 1.5;
    /* clamp to 2 lines to keep both cards same height */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.5em * 2);
}
.home-article-small-date{
    color: #6a7f91;
    font-size: 12.5px;
    margin: 0;
}
.home-article-small-date b{ color: var(--h-navy); font-weight: 700; }
.home-article-small-link{
    color: var(--h-orange);
    font-weight: 700;
    font-size: 12.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

/* ------- SPONSOR CAROUSEL ------- */
.home-sponsors{
    background: linear-gradient(135deg, var(--h-navy) 0%, var(--h-navy-2) 100%);
    padding: 70px 0;
    position:relative;
    overflow:hidden;
}
.home-sponsors::before{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(0deg, transparent 0, rgba(10,25,38,.4) 100%),
        var(--h-sponsor-bg) center/cover no-repeat;
    opacity:.4;
    pointer-events:none;
}
.home-sponsors-head{
    position:relative;
    z-index:1;
    text-align:center;
    margin-bottom: 36px;
}
.home-sponsors-head h2{
    color:#fff;
    font-size: clamp(26px, 3vw, 32px);
    font-weight:800;
    margin: 0 0 12px;
    position:relative;
    display:inline-block;
    padding-bottom: 14px;
}
.home-sponsors-head h2::after{
    content:"";
    position:absolute;
    left:50%; bottom:0;
    transform:translateX(-50%);
    width:72px; height:3px;
    background:var(--h-orange);
    border-radius:2px;
}
.home-carousel{
    position:relative;
    z-index:1;
    max-width: 1240px;
    margin: 0 auto;
    overflow:hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
}
.home-carousel-track{
    display:flex;
    gap: 20px;
    width: max-content;
    animation: home-marquee 34s linear infinite;
}
.home-carousel:hover .home-carousel-track,
.home-carousel-track.paused{ animation-play-state: paused; }
.home-carousel-item{
    flex: 0 0 180px;
    height: 110px;
    background:#fff;
    border-radius: 12px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:6px;
    padding: 14px;
    text-align:center;
}
.home-carousel-item img{
    max-width: 72px;
    max-height: 48px;
    object-fit: contain;
    display:block;
}
.home-carousel-item p{
    margin:0;
    font-size:12px;
    font-weight:700;
    color:var(--h-navy);
    line-height:1.3;
}
.home-carousel-item p small{display:block; color:#8ea0b0; font-weight:600; font-size:11px}
.home-carousel-ctrl{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:44px; height:44px;
    border-radius:50%;
    background:rgba(255,255,255,.1);
    border:1px solid rgba(255,255,255,.25);
    color:#fff;
    font-size:20px;
    cursor:pointer;
    z-index:3;
    display:grid;
    place-items:center;
    transition: background .2s;
}
.home-carousel-ctrl:hover{ background:rgba(245,166,80,.4); border-color:var(--h-orange); }
.home-carousel-prev{ left: 12px; }
.home-carousel-next{ right: 12px; }

/* RTL marquee: scroll from -half (right) to 0 (left),
   so logos visually move from right to left on screen. */
@keyframes home-marquee{
    from{ transform: translateX(-50%); }
    to  { transform: translateX(0); }
}
@media (prefers-reduced-motion: reduce){
    .home-carousel-track{ animation: none; }
}

/* ------- JOIN SECTION — minimal, light, single CTA ------- */
.home-join{
    background: #f6f9fc;
    padding: 100px 24px;
}
.home-join-wrap{
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    direction: rtl;
}
.home-join h2{
    color: var(--h-navy);
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 800;
    margin: 0 0 18px;
    line-height: 1.35;
}
.home-join p{
    color: #4a6174;
    font-size: 16px;
    line-height: 1.95;
    margin: 0 0 32px;
}
.home-join-cta{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--h-orange);
    color: #1a1a1a;
    text-decoration: none;
    padding: 14px 36px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 15.5px;
    transition: transform .25s ease, box-shadow .25s ease;
}
.home-join-cta:hover{
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(245,166,80,.35);
}

/* ------- Scroll reveal ------- */
.home-reveal{
    opacity: 0;
    transform: translateY(28px);
    transition: opacity .7s ease, transform .7s ease;
}
.home-reveal.in{
    opacity: 1;
    transform: translateY(0);
}
@media (prefers-reduced-motion: reduce){
    .home-reveal{ opacity: 1; transform: none; transition: none; }
    .home-event-card, .home-article-card{ transition: none; }
}

/* ------- FOOTER ------- */
.home-footer{
    background: #071d2c;
    color: #cdd8e2;
    padding: 60px 24px 24px;
    position:relative;
}
.home-footer-wrap{
    max-width: 1240px;
    margin: 0 auto;
    display:grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 40px;
    direction:rtl;
}
.home-footer-brand{ display:flex; flex-direction:column; gap:14px; }
.home-footer-brand .logos{
    display:flex;
    align-items:center;
    gap:14px;
}
.home-footer-brand .logos img{
    height: 50px;
    width:auto;
    object-fit:contain;
    background:#fff;
    border-radius:10px;
    padding:6px 8px;
}
.home-footer-brand p{
    color:#9fb3c4;
    font-size:14px;
    line-height:1.9;
    margin:0;
}
.home-footer h4{
    color:#fff;
    font-size:15px;
    font-weight:800;
    margin: 0 0 16px;
    padding-bottom:10px;
    border-bottom:2px solid rgba(245,166,80,.3);
}
.home-footer ul{
    list-style:none;
    padding:0;
    margin:0;
    display:flex;
    flex-direction:column;
    gap:10px;
}
.home-footer ul a,
.home-footer ul li{
    color:#9fb3c4;
    text-decoration:none;
    font-size:14px;
    line-height:1.8;
    transition: color .2s;
}
.home-footer ul a:hover{ color: var(--h-orange); }
.home-footer-contact li{
    display:flex;
    gap:10px;
    align-items:flex-start;
}
.home-footer-contact li b{
    color:#fff;
    font-weight:700;
}
.home-footer-bar{
    max-width:1240px;
    margin: 36px auto 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,.08);
    text-align:center;
    color:#7a8e9f;
    font-size:13px;
}

/* ------- RESPONSIVE ------- */
@media (max-width: 1000px){
    .home-hero{ min-height: 92vh; }
    .home-hero-wrap{ padding: 120px 24px 80px; }
    .home-hero h1{ font-size: clamp(24px, 4.5vw, 36px); }
    .home-vm{ gap: 18px; min-height: 380px; }
    .home-vm-panel{ padding: 56px 36px; }
    .home-vm-head{ font-size: 28px; }
    .home-vm-marker{ top: 36px; font-size: 12px; }
    .home-vm-marker::before{ width: 56px; }
    .home-vm-vision .home-vm-marker{ right: 36px; }
    .home-vm-mission .home-vm-marker{ left: 36px; }
    .home-vm-vision > .home-vm-chamfer{ width: 90px; height: 90px; }
    .home-vm-mission > .home-vm-chamfer{ width: 90px; height: 90px; }
    .home-vm-mission > .home-vm-chamfer::after{ width: 128px; }
    .home-vm-deco{ width: 200px; height: 100px; }
    .home-vm-deco::before{ width: 200px; height: 75px; }
    .home-vm-deco::after{ width: 170px; height: 90px; }
    .home-events-grid{ grid-template-columns: 1fr 1fr; }
    .home-articles{ grid-template-columns: 1fr; gap: 20px; }
    .home-article-small-col{ grid-template-columns: 1fr 1fr; }
    .home-footer-wrap{ grid-template-columns: 1fr 1fr; }
}
@media (max-width: 680px){
    .home-sec{ padding: 60px 18px; }
    .home-hero{ min-height: 88vh; }
    .home-hero-wrap{ padding: 110px 18px 70px; }
    .home-hero h1{ font-size: clamp(22px, 7vw, 28px); line-height: 1.4; }
    .home-hero p{ font-size: 14px; }
    .home-hero-cta{ width: 100%; flex-direction: column; }
    .home-hero-cta a{ width: 100%; justify-content: center; }
    .home-vm{ grid-template-columns: 1fr; gap: 20px; min-height: auto; }
    .home-vm::before{ display: none; }  /* no central divider when stacked */
    .home-vm-panel{ padding: 48px 28px; }
    /* Mobile: drop the chamfered corners so the panels fill cleanly. */
    .home-vm-vision > .home-vm-chamfer{ display: none; }
    .home-vm-mission > .home-vm-chamfer{ display: none; }
    .home-vm-head{ font-size: 26px; }
    .home-vm-marker{ top: 24px; font-size: 12px; }
    .home-vm-marker::before{ width: 42px; }
    .home-vm-vision .home-vm-marker{ right: 24px; }
    .home-vm-mission .home-vm-marker{ left: 24px; }
    .home-vm-deco{ width: 150px; height: 80px; }
    .home-vm-deco::before{ width: 150px; height: 60px; }
    .home-vm-deco::after{ width: 125px; height: 70px; }
    .home-vm-mission::after{ width: 60%; height: 50%; }
    .home-events-grid{ grid-template-columns: 1fr; }
    .home-articles{ grid-template-columns: 1fr; }
    .home-article-featured{ aspect-ratio: 4/3; }
    .home-article-featured-body{ padding: 18px 18px 18px; }
    .home-article-small-col{ grid-template-columns: 1fr; }
    .home-join{ padding: 70px 20px; }
    .home-carousel-item{ flex-basis: 140px; height: 92px; }
    .home-footer-wrap{ grid-template-columns: 1fr; gap:28px; }
}
